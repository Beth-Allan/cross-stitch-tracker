# Database (Neon)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_USER_EMAIL="your-email@example.com"
# IMPORTANT: Escape $ signs with \$ in bcrypt hashes (Next.js interprets $ as variable substitution)
AUTH_USER_PASSWORD_HASH="\$2b\$10\$your-bcrypt-hash-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (file storage) — all four are required; a missing one throws
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-api-token-access-key"
R2_SECRET_ACCESS_KEY="your-r2-api-token-secret"
R2_BUCKET_NAME="cross-stitch-tracker"

# Cloudflare R2 scratch bucket — Vercel Preview only, unset everywhere else.
# When set, the app reads R2_BUCKET_NAME but writes and deletes only here, so a
# preview deployment cannot alter a real file (read real, write scratch).
# The credential pair is optional: supply it to let the pair above be read-only,
# omit it to use the pair above for both buckets.
# R2_SCRATCH_BUCKET_NAME="cross-stitch-tracker-preview"
# R2_SCRATCH_ACCESS_KEY_ID="scratch-bucket-access-key"
# R2_SCRATCH_SECRET_ACCESS_KEY="scratch-bucket-secret"

# Statistics
STATS_TIMEZONE="America/Edmonton"
